    "web:figma": "node scripts/web-figma.mjs",
    "web:compare": "node scripts/web-compare.mjs",
    "figma:connect": "figma connect publish",
    "typecheck": "tsc --noEmit",
    "ds:verify": "node scripts/verify-render.mjs",
    "ds:verify-docs": "node scripts/verify-docs-overlays.mjs",
    "ds:verify-interact": "node scripts/verify-interactions.mjs",
    "ds:docs": "node scripts/ds.mjs docs",
    "ds:catalog": "node scripts/catalog-cli.mjs",
