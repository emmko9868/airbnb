{
  "name": "ds-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "type": "module",
  "description": "VS Code Qwen Code 확장과 개인 Token Plan으로 대화하며 로컬 Storybook 컴포넌트를 만드는 교육용 디자인 시스템 스타터킷",
  "scripts": {
    "ai:usage": "node scripts/ai-usage.mjs",
    "ai:check": "node scripts/ai-check.mjs check",
    "ai:verify": "node scripts/verify-story-play.mjs",
    "mcp:setup": "node scripts/figma-mcp-setup.mjs",
    "assets": "node scripts/assets.mjs",
    "specs": "node scripts/my-docs.mjs",
    "ds": "node scripts/ds.mjs",
    "ds:apply-token-plan": "node scripts/apply-token-plan.mjs",
    "ds:reset-typography": "node scripts/reset-typography.mjs",
    "ds:tokens": "node scripts/ds.mjs tokens",
    "ds:gen": "node scripts/ds.mjs gen",
    "ds:diff": "node scripts/ds.mjs diff",
    "ds:guard": "node scripts/ds.mjs guard",
    "ds:enrich": "node scripts/ds.mjs enrich",
    "ds:all": "node scripts/ds.mjs all",
    "ds:figma": "node scripts/figma-tokens.mjs",
